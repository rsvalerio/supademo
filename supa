#!/usr/bin/env bash
# The Supabase CLI, with nothing to install first.
#
#   ./supa start
#   ./supa db query --local "select * from api.plans"
#
# On first use this downloads the pinned CLI binary into .supabase-cli/ and
# verifies its checksum against scripts/cli.lock. Everything after that is the
# real CLI, unmodified — every flag and subcommand works as documented upstream.
source "$(dirname "${BASH_SOURCE[0]}")/scripts/lib/init.sh"
exec "$SUPABASE" "$@"
