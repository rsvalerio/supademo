node_modules/
dist/
build/
.turbo/

# env
.env
.env.*
!.env.example
supabase/functions/.env.local

# supabase cli
supabase/.branches/
supabase/.temp/
supabase/logs/

# Pinned tool binaries (Supabase CLI, Bun), fetched on first use. Cached rather
# than committed: they are ~100 MB each per platform, and the checksums in
# scripts/toolchain.lock are what actually pin them.
.toolchain/

# editors / os
.DS_Store
.idea/
# .vscode is committed: it scopes the Deno extension to supabase/functions so it
# does not fight the Node workspace, which is project setup rather than personal
# preference.

# deno
deno.lock
