supabase/logs/

# The pinned CLI binary, fetched on first use by ./supa. Cached rather than
# committed: it is ~110 MB per platform, and the checksum in scripts/_cli.sh is
# what actually pins it.
.supabase-cli/

# editors / os
.DS_Store
.idea/
# .vscode is committed: it scopes the Deno extension to supabase/functions so it
# does not fight the Node workspace, which is project setup rather than personal
# preference.

# deno
deno.lock
