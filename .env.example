# ---------------------------------------------------------------------------
# Local development
# `supabase start` prints these; the anon/service keys below are the well-known
# local demo keys and are safe to commit. Never put hosted keys in this file.
# ---------------------------------------------------------------------------
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Hosted project (used by scripts/ and CI). Get the ref from the dashboard URL.
SUPABASE_PROJECT_REF=
SUPABASE_ACCESS_TOKEN=

# ---------------------------------------------------------------------------
# Auth providers (referenced by supabase/config.toml via env())
# ---------------------------------------------------------------------------
SUPABASE_AUTH_GITHUB_CLIENT_ID=
SUPABASE_AUTH_GITHUB_SECRET=
SUPABASE_AUTH_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_GOOGLE_SECRET=

# Shared secret between GoTrue and the auth-email-hook edge function.
# Format: v1,whsec_<base64>
AUTH_HOOK_SECRET=

# ---------------------------------------------------------------------------
# Edge function secrets (set locally in supabase/functions/.env.local,
# in production with `supabase secrets set --env-file ...`)
# ---------------------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM="Supademo <hello@example.com>"

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_SCALE=

# Public base URL used to build links in emails and checkout redirects.
APP_BASE_URL=http://localhost:3000
