{
  "name": "supademo",
  "private": true,
  "version": "0.1.0",
  "description": "Backend-first Supabase reference SaaS. Frontends land in apps/ later.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "//": "Node is NOT required for backend work \u2014 make (or bash scripts/*.sh directly) needs only Docker, curl and a shell. These aliases exist for npm muscle memory and for the frontends that will live in apps/.",
  "scripts": {
    "setup": "bash scripts/setup.sh",
    "doctor": "bash scripts/doctor.sh",
    "verify": "bash scripts/verify.sh",
    "start": "bash scripts/stack.sh start",
    "stop": "bash scripts/stack.sh stop",
    "status": "bash scripts/stack.sh status",
    "test": "bash scripts/db.sh test",
    "db:reset": "bash scripts/db.sh reset",
    "db:lint": "bash scripts/db.sh lint",
    "db:advisors": "bash scripts/db.sh advisors",
    "gen:types": "bash scripts/types.sh",
    "functions:serve": "bash scripts/functions.sh serve",
    "functions:deploy": "bash scripts/functions.sh deploy"
  }
}
