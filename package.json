{
  "name": "supademo",
  "private": true,
  "version": "0.1.0",
  "description": "Backend-first Supabase reference SaaS. Frontends land in apps/ later.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:reset": "supabase db reset",
    "db:diff": "supabase db diff -f",
    "db:lint": "supabase db lint --level warning",
    "db:push": "supabase db push",
    "test:db": "supabase test db",
    "gen:types": "bash scripts/gen-types.sh",
    "functions:serve": "supabase functions serve --env-file supabase/functions/.env.local",
    "functions:deploy": "bash scripts/deploy-functions.sh",
    "verify": "bash scripts/verify.sh",
    "format": "deno fmt supabase/functions",
    "lint:functions": "deno lint supabase/functions",
    "check:functions": "deno check supabase/functions/**/index.ts"
  },
  "devDependencies": {
    "supabase": "^2.30.4"
  }
}
