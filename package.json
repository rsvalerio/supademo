{
  "name": "supademo",
  "private": true,
  "version": "0.1.0",
  "description": "Backend-first Supabase reference SaaS. Frontends land in apps/ later.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "setup": "bash scripts/bootstrap.sh",
    "start": "supabase start",
    "stop": "supabase stop",
    "stop:clean": "supabase stop --no-backup",
    "restart": "supabase stop && supabase start",
    "status": "supabase status",
    "status:json": "supabase status -o json",
    "services": "supabase services",
    "db:reset": "supabase db reset",
    "db:new": "supabase migration new",
    "db:up": "supabase migration up",
    "db:list": "supabase migration list",
    "db:squash": "supabase migration squash",
    "db:diff": "supabase db diff -f",
    "db:dump": "supabase db dump --local -f supabase/schema.sql",
    "db:query": "supabase db query --local",
    "db:lint": "supabase db lint --local --level warning",
    "db:advisors": "supabase db advisors --local --level warn",
    "db:inspect": "supabase inspect db table-stats --local",
    "test": "npm run test:db",
    "test:db": "supabase test db --local",
    "test:new": "supabase test new",
    "gen:types": "bash scripts/gen-types.sh",
    "gen:types:swift": "supabase gen types --local --lang swift --schema public,api",
    "functions:serve": "bash scripts/serve-functions.sh",
    "functions:new": "supabase functions new",
    "functions:deploy": "bash scripts/deploy-functions.sh",
    "functions:list": "supabase functions list",
    "link": "supabase link",
    "db:push": "supabase db push --linked",
    "db:pull": "supabase db pull --linked",
    "config:push": "supabase config push",
    "secrets:list": "supabase secrets list",
    "secrets:set": "supabase secrets set --env-file supabase/functions/.env.local",
    "verify": "bash scripts/verify.sh",
    "fmt": "deno fmt supabase/functions",
    "lint:functions": "deno lint supabase/functions",
    "check:functions": "deno check supabase/functions/*/index.ts"
  },
  "devDependencies": {
    "supabase": "2.113.0"
  }
}
